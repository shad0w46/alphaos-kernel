# ==============================================================================
# AlphaOS Kernel .gitignore
# ==============================================================================

# Compiled Debian Packages and packaging metadata
*.deb
*.ddeb
*.udeb
*.changes
*.buildinfo
linux-upstream_*

# Kernel and boot binary artifacts (large binaries)
vmlinuz*
initrd.img*
System.map*
*.iso
*.img
*.qcow2

# Cryptographic Private Keys and sensitive certificates
# (Public DER certificate can be tracked, but NEVER commit private keys)
certs/*.priv
certs/*.key
certs/*.pem
certs/*.p12
certs/*.pfx
*.priv
*.key

# Intermediate build objects
*.o
*.ko
*.ko.xz
*.ko.zst
*.a
*.cmd
*.d
*.dtb
*.dtbo
*.symvers
*.order
*.mod
*.mod.c
*.mod.o

# Kernel tree build output & temporary files
/vmlinux
/vmlinux.*
/bzImage
/arch/*/boot/bzImage
/arch/*/boot/compressed/
/include/config/
/include/generated/
/scripts/mod/
/scripts/basic/
/scripts/dtc/
/tools/objtool/
/tools/bpf/resolve_btfids/
/.tmp_versions/

# Configuration backups and temporary files
*.backup
*.old
.config.old
.config.backup
defconfig

# Build directories
build/
debian/

# Editor and IDE configs
.vscode/
.idea/
*.swp
*.tmp
*~

# Python cache
__pycache__/
*.pyc

# Logs
*.log
